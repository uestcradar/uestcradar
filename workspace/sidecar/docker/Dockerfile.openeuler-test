ARG OPENEULER_BASE=registry.chengyistudio.com/cxx/sidecar@sha256:0a2a7d06ea0cec3c191bde6536f701cd7447cb2c1da4099500e43a7414e2bdc2
ARG OPENEULER_BUILD_BASE=registry.chengyistudio.com/cxx/sidecar@sha256:1fe34d35fd560184614694e1f5b6fff9de1a06d9edba497d20d89acebcbcbfc8
ARG UCX_SOURCE_IMAGE=registry.chengyistudio.com/cxx/sidecar@sha256:a70527380102639192e13e4881992e0a72fea611fea8bf10c1cc17696638bb43

FROM ${UCX_SOURCE_IMAGE} AS ucx_source

FROM ${OPENEULER_BUILD_BASE} AS build

ARG UCX_VERSION=1.16.0
ARG UCX_SHA256=f73770d3b583c91aba5fb07557e655ead0786e057018bfe42f0ebe8716e9d28c

ENV TOOLSET_ROOT=/opt/openEuler/gcc-toolset-10/root/usr
ENV PATH=/opt/openEuler/gcc-toolset-10/root/usr/bin:/opt/ucx/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/openEuler/gcc-toolset-10/root/usr/lib64:/opt/ucx/lib
ENV PKG_CONFIG_PATH=/opt/ucx/lib/pkgconfig

WORKDIR /tmp
COPY --from=ucx_source /ucx-1.16.0.tar.gz ./ucx-1.16.0.tar.gz
ARG BUILD_JOBS=2
RUN echo "${UCX_SHA256}  ucx-${UCX_VERSION}.tar.gz" | sha256sum -c - \
    && tar -xzf "ucx-${UCX_VERSION}.tar.gz" \
    && cd "ucx-${UCX_VERSION}" \
    && CC="${TOOLSET_ROOT}/bin/gcc" \
       CXX="${TOOLSET_ROOT}/bin/g++" \
       ./configure \
         --prefix=/opt/ucx \
         --with-verbs \
         --with-rdmacm \
         --without-cuda \
         --without-rocm \
         --without-java \
    && make -j"${BUILD_JOBS}" \
    && make install \
    && rm -rf "/tmp/ucx-${UCX_VERSION}" "/tmp/ucx-${UCX_VERSION}.tar.gz"

WORKDIR /src
COPY workspace/common/ringbuf/ ./workspace/common/ringbuf/
COPY workspace/proto/telemetry.proto ./workspace/proto/telemetry.proto
COPY workspace/sidecar/ ./workspace/sidecar/

RUN cmake -S workspace/sidecar -B sidecar-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CXX_COMPILER="${TOOLSET_ROOT}/bin/g++" \
      -DBUILD_TESTING=OFF \
    && cmake --build sidecar-build --target sidecar --parallel "${BUILD_JOBS}"

FROM ${OPENEULER_BASE} AS runtime

RUN test "$(uname -m)" = "aarch64" \
    && dnf install -y \
      ca-certificates \
      gcc-toolset-10-libstdc++ \
      rdma-core-35.0-5.oe2003sp4 \
    && dnf clean all \
    && rpm -q rdma-core-35.0-5.oe2003sp4 \
    && test -f /usr/lib64/libibverbs/libhns-rdmav34.so

ENV PATH=/opt/ucx/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/ucx/lib:/opt/openEuler/gcc-toolset-10/root/usr/lib64

WORKDIR /app
COPY --from=build /opt/ucx/ /opt/ucx/
COPY --from=build /src/sidecar-build/sidecar /app/sidecar

RUN ldd /app/sidecar \
    && ucx_info -v

ENTRYPOINT ["/app/sidecar"]
