# ==============================================================================
# 雷达 Sidecar 多节点分布式部署环境变量配置模板 (node.env)
# ==============================================================================
# 使用说明：
# 在目标物理节点上复制此文件为 node.env，并根据机器角色 (Host A / B / C) 调整相关参数。
# 执行启动：docker compose -f compose.cascade.distributed.yaml --env-file node.env up -d
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 容器镜像配置 (可以使用固定 Tag 或私有源不可变 Registry Digest)
# ------------------------------------------------------------------------------
SIDECAR_IMAGE=registry.chengyistudio.com/cxx/sidecar:latest
WORKER_IMAGE=registry.chengyistudio.com/cxx/worker:cascade-worker-latest
TELEMETRY_IMAGE=registry.chengyistudio.com/cxx/web:latest

# ------------------------------------------------------------------------------
# 2. 节点身份与角色分工配置
# ------------------------------------------------------------------------------
# 节点 ID 标识 (必须唯一，如: node-a, node-b, node-c)
NODE_ID=node-a

# Cascade Worker 算子业务角色 (source: 信号源发包, operator: 中转处理, sink: 终端接收)
# - 机器 A (源头发包机) 填: source
# - 机器 B (中转算子机) 填: operator
# - 机器 C (终端接收机) 填: sink
CASCADE_ROLE=source

# ------------------------------------------------------------------------------
# 3. 遥测面板 (Telemetry Web) 与 UDP 网络配置
# ------------------------------------------------------------------------------
# 遥测 UDP 包接收端目标 IP (填写运行 telemetry-web 容器的观察机/机器 C 的物理局域网 IP)
# - 如果当前节点就是 Web 接收机 (Host C)，填: 127.0.0.1
# - 如果是远端发包节点 (Host A / B)，填 Host C 的真实局域网 IP (例如: 192.162.2.128)
TELEMETRY_HOST=127.0.0.1

# 遥测心跳包 UDP 监听/推送端口 (默认 9900)
TELEMETRY_PORT=9900

# 遥测 Web 浏览器图形化界面 HTTP 端口 (使用 docker run 手动拉起 telemetry-web 时访问)
TELEMETRY_WEB_PORT=8081

# 遥测指标采样间隔 (单位: ms，默认 100ms 发送一次 UDP 报文)
SAMPLE_INTERVAL=100

# ------------------------------------------------------------------------------
# 4. 双 Leg 传输角色配置 (Upstream 上游 / Downstream 下游)
# ------------------------------------------------------------------------------
# 通道角色选项: listen (监听接收), connect (主动连接), disabled (禁用)
#
# === 示例配置 1：机器 A (Source 源节点) ===
UPSTREAM_ROLE=disabled
DOWNSTREAM_ROLE=connect
DOWNSTREAM_PEER_NODE_ID=node-b
DOWNSTREAM_PEER_HOST=192.162.2.32
DOWNSTREAM_PORT=13337

# === 示例配置 2：机器 B (Operator 中转算子节点) ===
# UPSTREAM_ROLE=listen
# UPSTREAM_PEER_NODE_ID=node-a
# UPSTREAM_BIND_HOST=0.0.0.0
# UPSTREAM_PORT=13337
# DOWNSTREAM_ROLE=connect
# DOWNSTREAM_PEER_NODE_ID=node-c
# DOWNSTREAM_PEER_HOST=192.162.2.64
# DOWNSTREAM_PORT=13337

# === 示例配置 3：机器 C (Sink 终端接收节点) ===
# UPSTREAM_ROLE=listen
# UPSTREAM_PEER_NODE_ID=node-b
# UPSTREAM_BIND_HOST=0.0.0.0
# UPSTREAM_PORT=13337
# DOWNSTREAM_ROLE=disabled

# 建立连接超时时间 (单位: ms)
CONNECT_TIMEOUT_MS=1000

UPSTREAM_TYPE_ID=1
UPSTREAM_TYPE_VERSION=3
DOWNSTREAM_TYPE_ID=1
DOWNSTREAM_TYPE_VERSION=3

# ------------------------------------------------------------------------------
# 5. UCX 与物理 RDMA 网络配置
# ------------------------------------------------------------------------------
# 数据传输路径 (strict-rdma: 硬件硬 RDMA 传输; functional: TCP 协议栈)
SIDECAR_DATA_PATH=strict-rdma

# UCX 传输层协议 (物理 RDMA 网络推荐 rc_verbs,tcp，普通网络推荐 tcp,self)
UCX_TLS=rc_verbs,tcp

# UCX 网卡设备绑定 (指定 RoCE/Infiniband 网卡设备名，如: hns_1:1,enp125s0f1 或 all)
UCX_NET_DEVICES=all

# UCX 高级性能调优参数
UCX_SOCKADDR_TLS_PRIORITY=tcp
UCX_RC_VERBS_TX_MIN_SGE=2
UCX_RC_VERBS_TX_MIN_INLINE=0
UCX_RNDV_THRESH=64
UCX_ZCOPY_THRESH=64
UCX_RNDV_SCHEME=put_zcopy
UCX_PROTO_INFO=n
UCX_LOG_LEVEL=warn

# ------------------------------------------------------------------------------
# 6. RingBuffer 共享内存 (IPC SHM) 性能配置
# ------------------------------------------------------------------------------
SLOT_COUNT=8
MAX_PAYLOAD_BYTES=4194304
SIDECAR_SHM_SIZE=256m

# ------------------------------------------------------------------------------
# Worker 使用镜像默认 Entrypoint；多角色 Worker 通过 CASCADE_ROLE 选择角色。
